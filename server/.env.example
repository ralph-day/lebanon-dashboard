# Google OAuth (create at console.cloud.google.com)
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/callback

# Google Service Account JSON (for Drive access - paste the full JSON as one line)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Access control - only these two emails
ALLOWED_EMAILS=nisrinekhoory@gmail.com,infomgmtreportofficer@gmail.com
ALLOWED_DOMAIN=

# Google Drive folder ID (already set to your folder)
DRIVE_FOLDER_ID=1DGavGDKXsZby7cmUtOK6jn9w9CJyiJyW

# Session secret - change to a long random string in production
SESSION_SECRET=change-this-to-something-long-and-random

# In production, set to your hosted frontend URL
CLIENT_URL=http://localhost:5173

PORT=3001
